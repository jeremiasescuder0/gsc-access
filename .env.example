# Login (único usuario autorizado) — ver core/auth/generate-password-hash.js para generar el
# hash sin escribir la contraseña en texto plano en ningún lado.
AUTH_USERNAME=gambitadmin
# Corré: node core/auth/generate-password-hash.js
AUTH_PASSWORD_HASH=

# Secreto de sesión — no se usa para firmar cookies (las sesiones son opacas, server-side), pero
# queda reservado para eventual uso futuro (ej. si se agrega un modo stateless). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google OAuth credentials (desde Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000

# Solo para producción (Vercel) — el filesystem serverless es efímero, no hay dónde persistir
# token.json. Copiá el refresh_token de tu token.json local (generado con `npm run auth`) acá.
# En local NO hace falta: si no está seteada, se usa token.json como siempre.
# GOOGLE_REFRESH_TOKEN=

# Solo para producción (Vercel) — Vercel KV (Redis), necesario porque el filesystem serverless
# no persiste Blog Projects / perfiles de cliente / inventario entre invocaciones. Se completan
# solas al conectar un KV store al proyecto desde el dashboard de Vercel. En local NO hace
# falta: si no están seteadas, se usan archivos JSON en data/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Gemini API Key (desde Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Search Console site URL
GSC_SITE_URL=sc-domain:yourdomain.com
# Google Ads
# Developer token: Google Ads → Herramientas → Centro de API
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# ID del MCC (sin guiones): ej. 1234567890
GOOGLE_ADS_MCC_ID=your_mcc_id_here

# Digest semanal de Ads (npm run digest-ads) — envío por email vía SMTP
# Con Gmail: usá una contraseña de aplicación (myaccount.google.com/apppasswords), no tu contraseña normal
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_app_password_here
EMAIL_FROM=your_email@gmail.com
# Uno o más destinatarios separados por coma
EMAIL_TO=team@example.com